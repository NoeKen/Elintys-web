# Développement local uniquement — copier en `.env.local` (jamais versionné).
# Vercel injecte ces valeurs selon l'environnement de déploiement.
#
# Toutes les variables NEXT_PUBLIC_* sont inlinées dans le bundle client au
# BUILD : elles sont publiques. N'y placer AUCUN secret.

# Environnement Elintys du build : local | ci | dev | uat | prod.
#   local : poste de développement (défaut si absente)
#   ci    : GitHub Actions
#   dev   : https://dev.elintys.com (branche dev)
#   uat   : https://uat.elintys.com (branche uat) — badge « UAT » visible
#   prod  : https://app.elintys.com (branche main)
# Effets : analytics Vercel actif UNIQUEMENT en prod ; dev et uat envoient
# `X-Robots-Tag: noindex` ; dev/uat/prod exigent une NEXT_PUBLIC_API_URL HTTPS
# publique (le build échoue sinon). Valeur inconnue => échec du build.
# Sans variable, une production Vercel (VERCEL_ENV=production) vaut prod.
NEXT_PUBLIC_ELINTYS_ENV=local

# API NestJS. Obligatoire pour tout build de production (`next build`) :
# aucun repli vers localhost ni vers l'API de production.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# URL publique du frontend (canonical, sitemap, liens absolus).
# Absente => https://app.elintys.com : la poser sur dev et uat.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origine du frontend utilisée par les configurations Playwright.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Valeurs attendues par environnement (à configurer dans Vercel, pas ici) :
#   dev  : NEXT_PUBLIC_ELINTYS_ENV=dev
#          NEXT_PUBLIC_API_URL=https://elintys-api-dev-1pdh.onrender.com/api/v1
#          NEXT_PUBLIC_SITE_URL=https://dev.elintys.com
#   uat  : NEXT_PUBLIC_ELINTYS_ENV=uat
#          NEXT_PUBLIC_API_URL=https://elintys-api-uat.onrender.com/api/v1
#          NEXT_PUBLIC_SITE_URL=https://uat.elintys.com
#          NEXT_PUBLIC_PAYPAL_ENV=sandbox
#   prod : NEXT_PUBLIC_ELINTYS_ENV=prod
#          NEXT_PUBLIC_API_URL=https://api.elintys.com/api/v1
#          NEXT_PUBLIC_SITE_URL=https://app.elintys.com
#          NEXT_PUBLIC_PAYPAL_ENV=live (uniquement quand l'API est en live)

# Environnement PayPal visé par le FRONTEND (sandbox | live).
# Sert uniquement à valider l'hôte de l'URL d'approbation avant redirection.
# Doit correspondre au PAYPAL_ENV de l'API. Absent => sandbox ; invalide => erreur.
NEXT_PUBLIC_PAYPAL_ENV=sandbox

# Retire les devtools TanStack Query (bouton flottant en bas à droite).
# Utilisé par les tests E2E : ce bouton recouvre la navigation mobile.
NEXT_PUBLIC_DISABLE_DEVTOOLS=false

# Intégrations serveur historiques — non lues par le code actuel du frontend
# (les courriels partent de l'API). Conservées vides pour mémoire.
RESEND_API_KEY=
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
