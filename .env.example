# Développement local uniquement.
# Vercel injecte NEXT_PUBLIC_API_URL selon l'environnement de déploiement.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Domaines de déploiement attendus (à configurer dans Vercel, pas ici) :
# Preview dev : NEXT_PUBLIC_APP_URL=https://dev.elintys.com
# Preview dev : NEXT_PUBLIC_API_URL=https://api.dev.elintys.com/api/v1
# Production  : NEXT_PUBLIC_APP_URL=https://app.elintys.com
# Production  : NEXT_PUBLIC_API_URL=https://api.elintys.com/api/v1

# Intégrations optionnelles
RESEND_API_KEY=
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=

# Environnement PayPal visé par le FRONTEND (sandbox | live).
# Sert uniquement à valider l'hôte de l'URL d'approbation avant redirection.
# Doit correspondre au PAYPAL_ENV de l'API. Absent ou invalide => sandbox.
NEXT_PUBLIC_PAYPAL_ENV=sandbox

# Retire les devtools TanStack Query (bouton flottant en bas à droite).
# Utilise par les tests E2E : ce bouton recouvre la navigation mobile.
NEXT_PUBLIC_DISABLE_DEVTOOLS=false
